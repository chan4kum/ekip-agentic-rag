APP_ENV=local
LOG_LEVEL=INFO

# LLM: any OpenAI-compatible endpoint (default Groq)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
LLM_API_KEY=
# OpenAI's newer models: LLM_LIMIT_FIELD=max_completion_tokens and LLM_SEND_TEMPERATURE=false
LLM_LIMIT_FIELD=max_tokens
LLM_SEND_TEMPERATURE=true
# stub = placeholder answers (no model); agent = the LangGraph agent (needs LLM_MODEL + LLM_API_KEY)
CHAT_BACKEND=stub
# memory = per process; postgres = survives restarts (run the migrations first)
CONVERSATION_STORE=memory

# Provider keys (values go in your local .env, never in git)
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Local infrastructure (Docker Compose, step 1.7)
DATABASE_URL=postgresql+asyncpg://ekip:ekip@localhost:5432/ekip
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200

# Optional: host port for Postgres if 5432 is already taken (default 5432)
# POSTGRES_HOST_PORT=5433

# Optional: Keycloak admin console password for local development (default: admin-dev-only)
# KEYCLOAK_ADMIN_PASSWORD=

# Prometheus scrape bearer (empty = /metrics returns 404)
METRICS_TOKEN=
